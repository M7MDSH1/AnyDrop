<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup / device-transfer rules (Android 12+). Exclude the plaintext
     cookies file and the app-private media folders under
     getExternalFilesDir()/AnyDrop (device-local content only, re-downloadable). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cookies.txt" />
        <exclude domain="external" path="AnyDrop/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cookies.txt" />
        <exclude domain="external" path="AnyDrop/" />
    </device-transfer>
</data-extraction-rules>